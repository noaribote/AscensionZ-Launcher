<html lang="fr-FR" xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="utf-8" http-equiv="Content-Security-Policy" content="script-src 'self' 'sha256-In6B8teKZQll5heMl9bS7CESTbGvuAt3VVV86BUQBDk='"/>
    <title><%= lang('app.title') %></title>
    <script src="./assets/js/scripts/uicore.js"></script>
    <script src="./assets/js/scripts/uibinder.js"></script>
    <link type="text/css" rel="stylesheet" href="./assets/css/launcher.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css" integrity="sha512-QeR2VH+lsBE5LSAe1Q5EnTBbe7XTBubt8dG93Y7gidSgdMCr8nVqKcfKAMyN96SV8KDbZVTDXChatu5G2KQGzg==" crossorigin="anonymous" referrerpolicy="no-referrer">
    <style>
        body {
            transition: background-image 1s ease;
            background-image: url('data:image/jpeg;base64,');
            background-size: cover;
            -webkit-user-select: none;
        }
        #main {
            display: none;
            height: calc(100% - 22px);
            background: linear-gradient(to top, rgba(0, 0, 0, 0.75) 0%, rgba(0, 0, 0, 0) 100%);
            width: 100%;
            position: absolute;
            z-index: 10;
        }
        #main[overlay] { filter: blur(3px) contrast(0.9) brightness(1.0); }
    </style>
</head>
<body bkid="<%=bkid%>">
    <div class="cloudDrift" aria-hidden="true">
        <img class="cloudPNG" src="assets/images/cloud.png">
        <img class="cloudPNG" src="assets/images/cloud.png">
    </div>
    <%- include('frame') %>
    <div id="main">
        <%- include('welcome') %>
        <%- include('login') %>
        <%- include('waiting') %>
        <%- include('loginOptions') %>
        <%- include('settings') %>
        <%- include('landing') %>
    </div>
    <%- include('overlay') %>
    <audio id="backgroundMusic" src="https://noaribote.fr/public/ascensionz/.online/playback.ogg" preload="auto" loop></audio>
    <script src="assets/js/scripts/sound.js"></script>
    <div id="loadingContainer">
        <div id="loadingContent">
            <div id="loadSpinnerContainer">
                 <img src="assets/images/HZ-logo.png" class="HZ_logo_contain">
            </div>
        </div>
    </div>
</body>
</html>
